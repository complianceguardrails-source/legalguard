{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://legalguard-postgrest.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://legalguard-postgrest.onrender.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "natusjatkachenko@gmail.com",
        "ascAppId": "6809155372",
        "appleTeamId": "JR9N4S72GG"
      }
    }
  }
}
